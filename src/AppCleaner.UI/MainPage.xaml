<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AppCleaner_UI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:AppCleaner_UI"
    xmlns:models="using:AppCleaner_UI.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 루트: 드래그앤드롭 수신 + 어둠 오버레이를 겹쳐 둠 -->
    <Grid AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver"
          DragLeave="OnDragLeave" Drop="OnDrop" Background="Transparent">

        <Grid Padding="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 헤더 -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/VanishLogo.png" Width="28" Height="28" VerticalAlignment="Center" />
                    <TextBlock Text="Vanish" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right"
                        Command="{x:Bind ViewModel.LoadAppsCommand}"
                        IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBool}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="새로고침" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 상태 줄 + 드롭 안내 -->
            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="16" Height="16" />
                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8DE;" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="바탕화면 바로가기를 끌어다 놓으면 해당 앱을 찾아 선택합니다"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- 본문: 좌(상세) / 우(목록) 반반 -->
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="5*" />
                </Grid.ColumnDefinitions>

                <!-- ===== 좌측: 선택 앱 상세 + 관련 파일 + 삭제 ===== -->
                <Border Grid.Column="0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="20">

                  <Grid>
                    <!-- 선택 없음 placeholder -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                                Visibility="{x:Bind ViewModel.SelectedApp, Mode=OneWay, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                        <FontIcon Glyph="&#xE7C5;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="오른쪽 목록에서 앱을 선택하세요"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <!-- 선택 있음: 상세 -->
                    <Grid Visibility="{x:Bind ViewModel.SelectedApp, Mode=OneWay, Converter={StaticResource NullToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 아이콘 + 이름 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14">
                            <Grid Width="56" Height="56">
                                <FontIcon Glyph="&#xE977;" FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          Visibility="{x:Bind ViewModel.SelectedApp.IconSource, Mode=OneWay, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                                <Image Source="{x:Bind ViewModel.SelectedApp.IconSource, Mode=OneWay}"
                                       Width="56" Height="56" />
                            </Grid>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.SelectedApp.Name, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedApp.PublisherDisplay, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 메타 정보 -->
                        <StackPanel Grid.Row="1" Spacing="6" Margin="0,18,0,0">
                            <Grid>
                                <TextBlock Text="버전" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedApp.Version, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="용량" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedApp.SizeDisplay, Mode=OneWay}" HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="설치 위치" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedApp.InstallLocationDisplay, Mode=OneWay}"
                                       TextWrapping="Wrap" FontSize="13" IsTextSelectionEnabled="True" />
                        </StackPanel>

                        <!-- 관련 파일(잔여물 미리보기) -->
                        <Grid Grid.Row="2" Margin="0,18,0,0" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="관련 파일" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsResidueLoading, Mode=OneWay}" Width="14" Height="14" />
                                    <TextBlock Text="{x:Bind ViewModel.ResidueStatus, Mode=OneWay}"
                                               VerticalAlignment="Center" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <CheckBox x:Name="SelectAllResidueBox" Content="전체 선택"
                                          HorizontalAlignment="Right" MinWidth="0" IsChecked="True"
                                          Click="OnSelectAllResidue" />
                            </Grid>
                            <Border Grid.Row="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <ListView ItemsSource="{x:Bind ViewModel.SelectedAppResidue, Mode=OneWay}"
                                          SelectionMode="None" Padding="4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ResidueItem">
                                            <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" Margin="0,1" MinWidth="0">
                                                <StackPanel Spacing="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{x:Bind KindLabel}" FontSize="11"
                                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                        <TextBlock Text="{x:Bind SizeDisplay}" FontSize="11"
                                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind Path}" FontSize="12" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>

                        <!-- 백업 / 삭제 버튼 -->
                        <Grid Grid.Row="3" Margin="0,16,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" HorizontalAlignment="Stretch"
                                    Click="OnBackupClick"
                                    IsEnabled="{x:Bind ViewModel.CanUninstall, Mode=OneWay}"
                                    ToolTipService.ToolTip="체크한 관련 파일을 .appbak으로 백업">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                                    <TextBlock Text="백업" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" HorizontalAlignment="Stretch"
                                    Click="OnUninstallClick"
                                    IsEnabled="{x:Bind ViewModel.CanUninstall, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                    <TextBlock Text="이 앱 삭제" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                  </Grid>
                </Border>

                <!-- ===== 우측: 설치 앱 목록 ===== -->
                <Border Grid.Column="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- 검색창 -->
                    <AutoSuggestBox Grid.Row="0" Margin="8,8,8,4"
                                    PlaceholderText="앱 검색 (이름 / 제조사)"
                                    QueryIcon="Find"
                                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Apps, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedApp, Mode=TwoWay}"
                              SelectionMode="Single" Padding="4">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AppInfo">
                                <Grid Padding="6,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="28" Height="28">
                                        <FontIcon Glyph="&#xE977;" FontSize="20" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                  Visibility="{x:Bind IconSource, Mode=OneWay, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                                        <Image Source="{x:Bind IconSource, Mode=OneWay}" Width="28" Height="28" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                                                    CornerRadius="4" Padding="5,0" VerticalAlignment="Center"
                                                    Visibility="{x:Bind IsPackaged, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="Store" FontSize="10"
                                                           Foreground="{ThemeResource SystemFillColorAttentionBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind PublisherDisplay}" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeDisplay}" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                  </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== 드래그 오버레이 (드롭 시 어두워짐 + 안내/인식 결과) ===== -->
        <Grid x:Name="DragOverlay" Visibility="Collapsed"
              Background="#CC000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <FontIcon x:Name="DragOverlayIcon" Glyph="&#xE8DE;" FontSize="56" Foreground="White" />
                <TextBlock x:Name="DragOverlayTitle" Text="여기에 바로가기를 놓으세요"
                           FontSize="22" FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="DragOverlaySubtitle" Text="해당 앱을 찾아 선택합니다"
                           FontSize="14" Foreground="#CCFFFFFF" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
                <ProgressRing x:Name="DragOverlayRing" IsActive="False" Width="28" Height="28" Foreground="White" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
